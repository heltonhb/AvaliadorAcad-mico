# ============================================================
# AnaliseTextos — Configurações via variáveis de ambiente
# Copie para .env e ajuste conforme necessário
# ============================================================

# Diretório base (default: parent do diretório do app)
# ANALISE_BASE_DIR=/home/helton/AnaliseTextos

# Diretório de análises (default: arquivos_bancas — sem espaços para compatibilidade Docker/Windows)
# ANALISE_ANALYSES_DIR=arquivos_bancas

# Timeout para aguardar indexação do PDF (segundos)
# WAIT_SOURCE_TIMEOUT=240
# GENERATE_TIMEOUT=600

# Timeout geral para comandos (segundos)
# RUN_CMD_TIMEOUT=300

# TTL do cache de diretórios peer_review (segundos)
# RBGLOB_CACHE_TTL=60

# Modo padrão: full ou lite
# ANALISE_DEFAULT_MODE=full

# Domínio padrão: cs, med, human
# ANALISE_DEFAULT_DOMAIN=cs

# Origens permitidas para CORS (separadas por vírgula)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Porta da API (default: 8000)
# API_PORT=8000

# ===== Autenticação & JWT =====
# Segredo para assinatura de tokens JWT (OBRIGATÓRIO em produção — gere com: openssl rand -hex 32)
# JWT_SECRET=your-secret-key-here

# Horas de validade do token JWT (default: 24)
# JWT_EXPIRY_HOURS=24

# Caminho do banco SQLite de usuários (default: app/data/users.db)
# DB_PATH=data/users.db

# ===== Rate Limiting =====
# Requests por minuto para endpoints de auth (default: 10)
# AUTH_RATE_LIMIT=10

# Requests por minuto para upload (default: 30)
# UPLOAD_RATE_LIMIT=30

# Requests por minuto para pipeline start (default: 5)
# PIPELINE_RATE_LIMIT=5

# ===== Observabilidade =====
# Nível de log: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Formato de log: json ou text (default: text)
# LOG_FORMAT=text
