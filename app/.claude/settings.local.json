{
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk git *)",
      "Bash(rtk grep *)",
      "Bash(sqlite3 *)",
      "Bash(python3 *)",
      "Bash(./start.sh dev *)",
      "Bash(rtk curl *)",
      "Bash(pkill *)",
      "Bash(rtk read *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/helton/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: runs after Edit/Write/MultiEdit on UI files and surfaces findings as system reminders."
}
