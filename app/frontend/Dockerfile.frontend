FROM node:20-alpine AS builder

WORKDIR /app
COPY app/frontend/package*.json ./
RUN npm install
COPY app/frontend/ ./
RUN npm run build   # genera la pasta /app/dist

# ---- Etapa de producción (servir con un servidor leve) ----
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD [\"nginx\", \"-g\", \"daemon off;\"]